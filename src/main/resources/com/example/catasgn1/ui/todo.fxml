<BorderPane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="557.0" prefWidth="986.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.catasgn1.controllers.TodoController">
   <center>
      <TableView fx:id="taskTableView" prefHeight="200.0" prefWidth="749.0" BorderPane.alignment="CENTER">
        <columns>
            <TableColumn fx:id="titleCol" prefWidth="192.0" text="Title" />
            <TableColumn fx:id="descriptionCol" prefWidth="441.0" text="Description" />
            <TableColumn fx:id="priorityCol" minWidth="0.0" prefWidth="71.0" text="Priority" />
            <TableColumn fx:id="dueDateCol" prefWidth="68.0" text="Due Date" />
            <TableColumn fx:id="categoryCol" prefWidth="63.0" text="Category" />
            <TableColumn fx:id="statusCol" prefWidth="51.0" text="Status" />
            <TableColumn fx:id="actionCol" prefWidth="95.0" text="Actions" />
        </columns>
      </TableView>
   </center>
   <top>
       <VBox prefHeight="71.0" prefWidth="749.0" BorderPane.alignment="CENTER">
           <MenuBar>
               <Menu mnemonicParsing="false" text="File">
                   <MenuItem mnemonicParsing="false" onAction="#onNew" text="New" />
               </Menu>
               <Menu mnemonicParsing="false" text="Help">
                   <MenuItem mnemonicParsing="false" onAction="#onAbout" text="About" />
               </Menu>
               <Menu mnemonicParsing="false" text="Exit">
                   <MenuItem mnemonicParsing="false" onAction="#onExit" text="Exit" />
               </Menu>
           </MenuBar>
           <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="todo-title" text="Todo List" textAlignment="CENTER">
              <font>
                  <Font size="36.0" />
              </font>
              <VBox.margin>
                  <Insets />
              </VBox.margin>
           </Label>
           <ToolBar maxWidth="1.7976931348623157E308" prefHeight="40.0" prefWidth="200.0">
           <Button mnemonicParsing="false" onAction="#showTaskDialog" prefHeight="35.0" prefWidth="35.0" styleClass="add-task-button">
               <graphic>
                  <FontIcon iconColor="WHITE" iconLiteral="fas-plus" />
               </graphic></Button>
            <Button layoutX="10.0" layoutY="17.0" mnemonicParsing="false" onAction="#refresh" prefHeight="35.0" prefWidth="35.0" styleClass="add-task-button">
               <graphic>
                  <FontIcon iconColor="WHITE" iconLiteral="fas-sync-alt" />
               </graphic></Button>
            <Region prefHeight="48.0" prefWidth="58.0" />
               <VBox layoutX="316.0" layoutY="10.0" prefHeight="48.0" prefWidth="323.0">
                   <Label text="Search" />
                   <TextField fx:id="fieldSearch" onKeyTyped="#handleKeyTyped" prefHeight="33.0" prefWidth="331.0" promptText="Search by Title, Description" />
               </VBox>
               <VBox prefHeight="48.0" prefWidth="120.0">
                   <Label text="Priority" />
                   <ComboBox fx:id="comboPriority" onAction="#handleComboPriority" prefHeight="33.0" prefWidth="150.0" promptText="None" />
               </VBox>
               <VBox layoutX="600.0" layoutY="10.0" prefHeight="48.0" prefWidth="120.0">
                   <Label text="Category" />
                   <ComboBox fx:id="comboCategory" onAction="#handleComboCategory" prefHeight="33.0" prefWidth="150.0" promptText="None" />
               </VBox>
               <VBox layoutX="10.0" layoutY="10.0" prefHeight="48.0" prefWidth="120.0">
                   <Label text="Status" />
                   <ComboBox fx:id="comboStatus" minHeight="34.0" onAction="#handleComboStatus" prefHeight="33.0" prefWidth="200.0" promptText="None" />
               </VBox>
               <VBox layoutX="697.0" layoutY="10.0" prefHeight="48.0" prefWidth="120.0">
                   <Label text="Due Date" />
                   <DatePicker fx:id="pickerDueDate" minHeight="34.0" onAction="#handlePickerDueDate" promptText="Due Date" />
               </VBox>
           </ToolBar>
       </VBox>
   </top>
