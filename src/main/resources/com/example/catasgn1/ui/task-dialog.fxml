<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="400.0" styleClass="content-area" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main">
   <children>
      <VBox alignment="CENTER" layoutX="68.0" layoutY="55.0" prefHeight="504.0" prefWidth="263.0" spacing="12.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         <children>
            <Label prefHeight="42.0" prefWidth="261.0" styleClass="title-label" text="Add Task" />
            <Label prefHeight="15.0" prefWidth="221.0" text="Title">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <TextField fx:id="titleField" promptText="Title" />
            <Label prefHeight="15.0" prefWidth="223.0" text="Description" />
            <TextArea fx:id="descriptionField" prefHeight="38.0" prefWidth="249.0" promptText="description" />
            <Label prefHeight="15.0" prefWidth="214.0" text="Category" />
            <ComboBox fx:id="categoryConboBox" prefHeight="33.0" prefWidth="221.0" promptText="Category" />
            <Label prefHeight="15.0" prefWidth="214.0" text="Priority" />
            <ComboBox fx:id="priorityComboBox" prefHeight="33.0" prefWidth="221.0" promptText="Priority" />
            <Label prefHeight="15.0" prefWidth="216.0" text="Due Date" />
            <DatePicker fx:id="dueDatePicker" prefHeight="25.0" prefWidth="215.0" promptText="Due Date" />
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button fx:id="saveButton" mnemonicParsing="false" text="+ Save" />
                  <Button fx:id="cancelButton" mnemonicParsing="false" text="x Cancel" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
